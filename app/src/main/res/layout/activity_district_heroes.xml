<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_off_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_mustard"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDistrictTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="District Name"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDistrictSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Heroes from this place"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDistrictHeroes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="16dp"
        android:clipToPadding="false"/>

</LinearLayout>
