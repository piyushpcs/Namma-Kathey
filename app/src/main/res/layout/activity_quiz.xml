<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_off_white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C5F91"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧠 Hero Quiz"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Score: 0 | Question 1/3"
            android:textColor="#B0C4DE"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/quizProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:progress="33"
            android:progressTint="@color/brand_mustard" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Question Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvQuestionNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Question 1 of 3"
                        android:textColor="@color/text_grey"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.4"
                        android:text="Which district is Kittur Chennamma from?"
                        android:textColor="@color/text_black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Answer Buttons -->
            <Button
                android:id="@+id/btnOption1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF"
                android:text="Kolar"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnOption2"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF"
                android:text="Mysuru"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnOption3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#FFFFFF"
                android:text="Belagavi"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnOption4"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FFFFFF"
                android:text="Kalaburagi"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

            <!-- Result Area -->
            <LinearLayout
                android:id="@+id/resultArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="❌ Wrong! Answer: Belagavi"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#2C5F91"
                    android:text="Next Question →"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Final Badge Celebration Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/badgeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/quest_card_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        android:id="@+id/tvBadgeEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥇"
                        android:textSize="80sp" />

                    <TextView
                        android:id="@+id/tvBadgeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Heritage Badge Earned!"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBadgeDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Karnataka History Master"
                        android:textColor="#F0F0F0"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnViewBadges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="#FFFFFF"
                        android:paddingHorizontal="24dp"
                        android:text="Finish Quiz 🎉"
                        android:textAllCaps="false"
                        android:textColor="@color/quest_gradient_end"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
