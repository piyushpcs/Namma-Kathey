<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="NammaKathey"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NammaKathey">

        <activity android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity"/>
        <activity android:name=".HeroListActivity"/>
        <activity android:name=".HeroDetailActivity"/>
        <activity android:name=".QuizActivity"/>
        <activity android:name=".TimelineActivity"/>
        <activity android:name=".StorybookActivity"/>
        <activity android:name=".DistrictMapActivity"/>
        <activity android:name=".DistrictHeroesActivity"/>
        <activity android:name=".ProfileActivity"/>
    </application>

</manifest>